generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Utilisateurs et rôles
// ---------------------------------------------------------------------------

enum UserRole {
  CONTRIBUTOR
  REPRESENTATIVE
  MODERATOR
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         UserRole @default(CONTRIBUTOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  experiences   ProfessionalExperience[]
  reviews       Review[]
  reports       Report[]
  reviewLikes   ReviewLike[]
  reviewReplies ReviewReply[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Annuaire des entreprises (niveaux : entreprise / établissement / département)
// ---------------------------------------------------------------------------

enum CompanyStatus {
  PENDING
  PUBLISHED
  REJECTED
}

model Company {
  id                      String        @id @default(cuid())
  name                    String
  slug                    String?       @unique
  legalName               String?
  logoUrl                 String?
  sector                  String?
  description             String?
  website                 String?
  email                   String?
  phone                   String?
  address                 String?
  city                    String?
  size                    String?
  invitesClientReviews    Boolean?
  reviewInvitationDetails String?
  status                  CompanyStatus @default(PENDING)
  claimed                 Boolean       @default(false)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  establishments Establishment[]
  departments    Department[]
  experiences    ProfessionalExperience[]
  reviews        Review[]
  salaryReports  SalaryReport[]
  responses      ReviewResponse[]

  @@index([status, name])
  @@index([status, sector])
  @@index([status, city])
  @@map("companies")
}

model Establishment {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  city      String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews Review[]

  @@index([companyId])
  @@map("establishments")
}

model Department {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews Review[]

  @@index([companyId])
  @@map("departments")
}

// ---------------------------------------------------------------------------
// Expériences déclarées
// ---------------------------------------------------------------------------

model ProfessionalExperience {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobTitle     String
  contractType String?
  isCurrent    Boolean   @default(false)
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  reviews Review[]

  @@index([userId])
  @@index([companyId])
  @@map("professional_experiences")
}

// ---------------------------------------------------------------------------
// Avis, notation et salaires
// ---------------------------------------------------------------------------

enum Visibility {
  ANONYMOUS
  PSEUDONYM
  NOMINATIVE
}

enum ReviewStatus {
  DRAFT
  IN_VERIFICATION
  VERIFIED
  UNVERIFIED
  IN_MODERATION
  PUBLISHED
  REJECTED
  CONTESTED
}

enum Criterion {
  AMBIANCE
  MANAGEMENT
  REMUNERATION
  EVOLUTION
  WORKLOAD
  WORK_LIFE_BALANCE
  RECOGNITION
  WORK_CONDITIONS
  STABILITY
}

model Review {
  id              String                  @id @default(cuid())
  authorId        String
  author          User                    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  companyId       String
  company         Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  establishmentId String?
  establishment   Establishment?          @relation(fields: [establishmentId], references: [id], onDelete: SetNull)
  departmentId    String?
  department      Department?             @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  experienceId    String?
  experience      ProfessionalExperience? @relation(fields: [experienceId], references: [id], onDelete: SetNull)

  jobTitle     String
  contractType String?
  location     String?
  isCurrent    Boolean      @default(false)
  recommend    Boolean?
  visibility   Visibility   @default(ANONYMOUS)
  status       ReviewStatus @default(DRAFT)
  title        String?
  positives    String?
  negatives    String?
  comment      String?
  publishedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  ratings       Rating[]
  salaryReport  SalaryReport?
  verifications Verification[]
  responses     ReviewResponse[]
  reports       Report[]
  likes         ReviewLike[]
  replies       ReviewReply[]

  @@index([companyId, status, publishedAt])
  @@index([status, publishedAt])
  @@map("reviews")
}

model Rating {
  id        String    @id @default(cuid())
  reviewId  String
  review    Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  criterion Criterion
  score     Int

  @@unique([reviewId, criterion])
  @@map("ratings")
}

model SalaryReport {
  id        String   @id @default(cuid())
  reviewId  String   @unique
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobTitle  String
  amount    Decimal? @db.Decimal(12, 2)
  currency  String   @default("XOF")
  period    String   @default("MONTHLY")
  isNet     Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([companyId])
  @@map("salary_reports")
}

// ---------------------------------------------------------------------------
// Vérification, justificatifs, réponses, signalements et modération
// ---------------------------------------------------------------------------

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Verification {
  id         String             @id @default(cuid())
  reviewId   String
  review     Review             @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  method     String?
  status     VerificationStatus @default(PENDING)
  resultNote String?
  verifiedAt DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  documents Document[]

  @@index([reviewId, status])
  @@map("verifications")
}

model Document {
  id             String       @id @default(cuid())
  verificationId String
  verification   Verification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  originalName   String
  storageKey     String
  mimeType       String?
  sizeBytes      Int?
  createdAt      DateTime     @default(now())

  @@map("documents")
}

model ReviewResponse {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([reviewId])
  @@map("review_responses")
}

model ReviewLike {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([reviewId, userId])
  @@index([reviewId])
  @@map("review_likes")
}

model ReviewReply {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reviewId, createdAt])
  @@map("review_replies")
}

enum ReportStatus {
  OPEN
  REVIEWED
  CLOSED
}

model Report {
  id         String       @id @default(cuid())
  reviewId   String?
  review     Review?      @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  reporterId String?
  reporter   User?        @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  reason     String
  details    String?
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())

  @@map("reports")
}

model ModerationCase {
  id        String   @id @default(cuid())
  reviewId  String?
  reportId  String?
  decision  String?
  reason    String?
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("moderation_cases")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contact_messages")
}
